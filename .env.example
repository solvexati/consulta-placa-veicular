# Copie para .env.local (desenvolvimento) ou cadastre na Vercel com `vercel env add NOME`.
# NUNCA use o prefixo VITE_ nestas variáveis — elas são só do servidor.

# --- Provedor de dados veiculares --------------------------------
# mock = dados de demonstração (padrão). Ao plugar a API paga, use o nome do adaptador.
VEHICLE_PROVIDER=mock
VEHICLE_PROVIDER_API_URL=
VEHICLE_PROVIDER_API_KEY=

# --- Supabase (opcional; sem ele o backend usa memória) ----------
# Painel do Supabase > Project Settings > API. Use a chave service_role (secreta).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança ------------------------------------------------------
# Assina os tokens de acesso ao laudo. Obrigatório na Vercel (preview e produção).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
# Sal para anonimizar IPs nos logs
IP_HASH_SALT=

# --- Regras ---------------------------------------------------------
CACHE_BASIC_TTL_HOURS=168
CACHE_REPORT_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=20
# Desbloqueio de laudo sem pagamento real (até integrar o gateway)
SIMULATED_PAYMENTS=true
